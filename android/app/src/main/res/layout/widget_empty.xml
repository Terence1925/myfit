<?xml version="1.0" encoding="utf-8"?>
<!-- Shown until the app has sent today's plan (or after signing out). Also the widget's preview in the picker. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wg_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/wg_bg"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="MyFit"
        android:textColor="@color/wg_accent"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Today's workout"
        android:textColor="@color/wg_text"
        android:textSize="19sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Open MyFit to set up your plan"
        android:textColor="@color/wg_muted"
        android:textSize="12sp" />
</LinearLayout>
