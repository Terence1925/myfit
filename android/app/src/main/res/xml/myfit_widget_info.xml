<?xml version="1.0" encoding="utf-8"?>
<!-- Today's workout and your streak on the home screen. Can be stretched from 2x2 up to a wide 4x2. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:minResizeWidth="110dp"
    android:minResizeHeight="110dp"
    android:maxResizeHeight="220dp"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="3600000"
    android:initialLayout="@layout/widget_empty"
    android:previewLayout="@layout/widget_empty"
    android:description="@string/widget_description"
    android:widgetCategory="home_screen" />
