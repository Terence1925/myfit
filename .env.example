# Copy to .env.local and fill in. Leave blank / delete this file to keep running on
# the built-in mock backend (no signup required, data stays in your browser).

# Supabase project settings -> API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# RevenueCat public SDK key (Google Play API key from RevenueCat -> Project -> API Keys).
# Safe to ship in the client, same as a Stripe *publishable* key. Only used inside the
# native Android app (src/lib/platform.ts gates it) — the web build ignores this.
VITE_REVENUECAT_ANDROID_KEY=
VITE_REVENUECAT_IOS_KEY=

# Google sign-in: the "Web application" OAuth client ID from Google Cloud Console (ends in
# .apps.googleusercontent.com). Leave blank to hide the "Continue with Google" button.
VITE_GOOGLE_WEB_CLIENT_ID=

# YouTube Data API v3 key — optional. Powers the in-app exercise Demo modal (embeds the
# actual video instead of a plain link). Without it, the modal shows a "Search on YouTube"
# button instead. Free: console.cloud.google.com -> enable "YouTube Data API v3" -> Credentials
# -> Create API key. Free quota (10k units/day) covers ~100 exercise lookups/day; results are
# cached in the browser so repeat views of the same exercise don't re-query.
VITE_YOUTUBE_API_KEY=

# --- Everything below this line is set as Supabase Edge Function secrets ---
# (supabase secrets set NAME=value) — never put these in a client-side .env file.
#
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_MONTHLY=       # price_... id for the ₱399.99/mo Product
# STRIPE_PRICE_YEARLY=        # price_... id for the ₱3,999/yr Product
# REVENUECAT_WEBHOOK_SECRET=  # any long random string; also entered in RevenueCat's webhook config
# SITE_URL=                   # e.g. https://getmyfit.vercel.app (your deployed URL)
# SUPABASE_URL=               # same value as VITE_SUPABASE_URL above
# SUPABASE_SERVICE_ROLE_KEY=  # Project Settings -> API -> service_role (secret!)
# ANTHROPIC_API_KEY=          # only if you swap generate-program to a real LLM call
